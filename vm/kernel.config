# The kernel of a pod that runs in v86 (Dockerfile): tinyconfig for i386 and
# what a container needs on top of it. v86 emulates a Pentium-class PC with a
# serial port and virtio devices.
CONFIG_64BIT=n
CONFIG_X86_32=y
CONFIG_M686=y
CONFIG_SMP=n
# Without highmem a 32-bit kernel uses only about 896 MiB of RAM. A pod may
# get up to 2 GiB (web/src/vmworker.js).
CONFIG_NOHIGHMEM=n
CONFIG_HIGHMEM4G=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=n
CONFIG_PCI=y
# v86 has configuration type 1 (direct), so the kernel does not need the PCI
# BIOS. Direct boot without SeaBIOS needs it too.
CONFIG_PCI_GOANY=n
CONFIG_PCI_GODIRECT=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
# The root file system: the layers of the image over 9p (web/src/rootfs.js).
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_ACPI=n
CONFIG_MODULES=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_INFO_NONE=y
# -O2 instead of -Os: v86 runs the faster code faster. Measured in Node.js
# (3 x 4 rounds): nginx from "go" to HTTP ~2.2 -> ~1.9 s, 5 % fewer
# instructions in the kernel; vmlinux +0.2 MB with gzip, saved state
# +0.7 MiB (the kernel code is in it).
CONFIG_CC_OPTIMIZE_FOR_SIZE=n
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# Link time optimization: clang inlines across source files. The kernel
# runs 3-4 % fewer instructions, and the hot kernel code is more compact.
# Most kernel code runs in the interpreter of v86, so instructions are
# time. Together with SLUB_TINY=n (below), measured in Node.js (pod-bench
# of jkroepke/v86, 256 MiB, main-thread CPU, medians of 12-15 alternating
# runs): nginx from "go" to HTTP -2 %, a Go binary (start, 20 scrapes)
# -1 %, glibc text tools -6 to -7 %, an Alpine shell/gzip/sha256 job -5 %.
# LTO alone: -1 % to -2.5 %. Costs: vmlinux 5.4 -> 6.5 MB (gzip 2.07 ->
# 2.56 MB), saved state 8.5 -> 9.7 MiB, 0.9 MiB less free memory per pod.
# ThinLTO did not change the instructions.
CONFIG_LTO_NONE=n
CONFIG_LTO_CLANG_FULL=y
# tinyconfig picks SLUB_TINY: no per-CPU slabs, and an empty slab goes back
# to the page allocator at once. 9p allocates and frees small buffers for
# every request, so the kernel was busy with slabs and pages. Without it,
# glibc text tools run 13 % fewer kernel instructions (3.3 % of all) and
# need 2-4 % less CPU; nginx -1.4 % instructions. Costs: 0.6 MiB of memory
# per pod, 3.5 million more instructions in the first boot (same time).
CONFIG_SLUB_TINY=n
# The emulated CPU unpacks the kernel. LZ4 is bigger than gzip (+210 KiB)
# but unpacks in a third of the time: about -150 ms per pod start.
CONFIG_KERNEL_GZIP=n
CONFIG_KERNEL_LZ4=y
# The legacy PTYs (256 pairs of device nodes in devtmpfs) took 310 ms of
# every boot. init uses devpts.
CONFIG_LEGACY_PTYS=n
# A periodic tick costs host CPU while the pod is idle (a quarter of a core
# per pod with 250 Hz). Without it, an idle kernel costs almost nothing.
CONFIG_HZ_PERIODIC=n
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y
# NO_HZ_IDLE alone did nothing: the kernel stops its tick only with a clock
# source that is good for high resolution timers ("tsc=reliable" on the
# command line, web/src/vmworker.js) and a timer that can wait long enough.
# The PIT counts 16 bits: at most 27 ms, 37 interrupts per second in an
# idle pod. The timer of the local APIC (v86 option "acpi") waits as long
# as the kernel asks. Measured with an idle nginx pod: 100 -> 2 interrupts
# and 240k -> 16k instructions per second, 22 -> 3.3 ms of CPU per second in
# a Chromium worker (88 ms before v86 slept through the last millisecond of
# each tick).
CONFIG_X86_UP_APIC=y
# Nothing in the VM uses the crypto API (the random number generator uses
# BLAKE2s from lib/crypto). Without it, its self tests do not run either.
CONFIG_CRYPTO=n
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_SYSVIPC=y
CONFIG_X86_TSC=y
CONFIG_INPUT=n
CONFIG_VT=n
CONFIG_RTC_CLASS=n
# init sets up eth0 (vm/init/stage0.go), not the kernel.
CONFIG_IP_PNP=n
# init starts from an initramfs and waits there for the pod: the page saves
# the booted VM at that point (web/src/vmworker.js). The page builds the
# initramfs, uncompressed.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
# tinyconfig turns these off. Without the system calls with a 32 bit time_t,
# glibc ends a program with "The futex facility returned an unexpected error
# code": Debian images need them, musl (Alpine) does not.
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_HIGH_RES_TIMERS=y

# What v86 does not have and a pod does not need. Each of these is code
# that the emulated CPU unpacks or runs on every boot, and memory of every
# pod. Together: bzImage -188 KiB, -3 million instructions to "ready",
# +876 KiB free memory, saved state -0.6 MiB.
# v86 is an Intel CPU.
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_AMD=n
CONFIG_CPU_SUP_HYGON=n
CONFIG_CPU_SUP_CENTAUR=n
CONFIG_CPU_SUP_CYRIX_32=n
CONFIG_CPU_SUP_TRANSMETA_32=n
CONFIG_CPU_SUP_ZHAOXIN=n
CONFIG_CPU_SUP_VORTEX_32=n
CONFIG_PERF_EVENTS_INTEL_UNCORE=n
CONFIG_PERF_EVENTS_INTEL_RAPL=n
CONFIG_PERF_EVENTS_INTEL_CSTATE=n
# PCI Express, real hardware quirks and VGA arbitration.
CONFIG_PCIEASPM=n
CONFIG_PCI_QUIRKS=n
CONFIG_VGA_ARB=n
# init uses ttyS0 and ttyS1, the two ISA ports of v86. No PCI serial cards.
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_SERIAL_8250_PCI=n
CONFIG_SERIAL_8250_EXAR=n
CONFIG_SERIAL_8250_MOXA_PCIE=n
CONFIG_SERIAL_8250_LPSS=n
CONFIG_SERIAL_8250_MID=n
CONFIG_SERIAL_8250_PERICOM=n
CONFIG_EEPROM_93CX6=n
# No hardware clocks, no ethtool or socket diagnostics over netlink, no
# wireless. init sets up eth0 with ioctls.
CONFIG_PTP_1588_CLOCK=n
CONFIG_PPS=n
CONFIG_ETHTOOL_NETLINK=n
CONFIG_INET_DIAG=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
# 9p runs over virtio only; the virtio devices of v86 are virtio 1.0.
CONFIG_NET_9P_FD=n
CONFIG_VIRTIO_PCI_LEGACY=n
# The kernel log of a pod goes to ttyS0 as it is written: a buffer of 4 KiB
# instead of 128 KiB (and 400 KiB of metadata) is enough.
CONFIG_LOG_BUF_SHIFT=12
